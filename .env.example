# HalfSaid — environment variables (SPEC §15).
#
# Copy to `.env.local` (web app) / `.env` and fill in. NEVER commit real keys.
# Every layer must be developable and CI-green WITHOUT these keys via mock mode
# (HALFSAID_MOCK_MODE=true) — see SPEC §15 / deviation D8.
#
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser. Everything else is
# server-only and must never be sent to the client.

# --- Mock / fixture mode -----------------------------------------------------
# When true, ASR / LLM / embedding calls use committed fixtures instead of live
# APIs. This is the default for dev and CI so no secrets are required.
HALFSAID_MOCK_MODE=true

# --- Supabase (auth + Postgres + pgvector) -----------------------------------
# From `supabase start` (local) or your Supabase project settings (hosted).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the browser, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Groq (internal ops only: ASR + LLM) -------------------------------------
# Whisper large-v3 (streaming ASR) and Llama 3.3 70B for INTERNAL ops only
# (intent, paraphasia, similarity). Never user-facing text (Hard Rule, SPEC §0).
GROQ_API_KEY=your-groq-key

# --- Gemini (internal ops only: long-context) --------------------------------
# Gemini 2.0 Flash for internal ops / long-context queries only.
GEMINI_API_KEY=your-gemini-key

# --- Embeddings (hosted, 1024-d) ---------------------------------------------
# Hosted free-tier embedder producing/normalized to 1024-d vectors (SPEC O2/D10).
# Seed embeddings are computed once and committed as fixtures; query-path tests
# use cached/mock vectors so CI stays green without this key.
EMBEDDINGS_API_KEY=your-embeddings-key
EMBEDDINGS_MODEL=your-embeddings-model
EMBEDDINGS_DIM=1024
