{
  "name": "halfsaid",
  "version": "0.0.0",
  "private": true,
  "description": "HalfSaid — Personal Communication Intelligence Platform for people with aphasia (hackathon MVP).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "prettier --check . && npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:a11y": "jest --selectProjects web",
    "test:e2e": "npm run test:e2e --workspace=apps/web --if-present",
    "license-audit": "node scripts/license-audit.mjs",
    "db:apply-supabase": "node scripts/apply-supabase.mjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.5",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
